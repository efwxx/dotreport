# ---------- Required ----------

# Bungie.net API — https://www.bungie.net/en/Application
BUNGIE_API_KEY=

# Your Bungie name + code, e.g. Guardian#1234
BUNGIE_NAME=
BUNGIE_CODE=

# Additional accounts (optional, unlimited). Reference these from
# config/site.ts with `account: 2`, `account: 3`, ..., on individual activity
# sections. The lookup is fully dynamic — keep adding _N pairs as you need.
# BUNGIE_NAME_2=
# BUNGIE_CODE_2=
# BUNGIE_NAME_3=
# BUNGIE_CODE_3=
# BUNGIE_NAME_4=
# BUNGIE_CODE_4=
# ...and so on.

# Last.fm — https://www.last.fm/api/account/create
LASTFM_API_KEY=
LASTFM_USERNAME=


# ---------- Optional: display ----------

# Override what appears under the emblem (defaults to BUNGIE_NAME#BUNGIE_CODE).
# For alt accounts, use DISPLAY_NAME_2, DISPLAY_NAME_3, etc., matching the
# BUNGIE_NAME_<n> slots.
DISPLAY_NAME=
# DISPLAY_NAME_2=
# DISPLAY_NAME_3=


# ---------- Optional: tracked activity ----------

# Substring matched against the activity's Bungie display name. Catches every
# difficulty and reissue (Normal, Master, Challenge weeks, etc.).
# Examples: Vault of Glass, King's Fall, Crota's End, Salvation's Edge,
#           Warlord's Ruin, Ghosts of the Deep, Spire of the Watcher
#
# Set to "*" (or leave blank) to track the 10 most recent clears of ANY
# activity in the chosen mode. The "CLEARS" total then shows lifetime
# raids/dungeons across every character, including deleted ones.
TRACKED_ACTIVITY_NAME="Pantheon"

# raid (default) or dungeon
TRACKED_ACTIVITY_MODE=raid

# Card title. Defaults to "Recent <TRACKED_ACTIVITY_NAME>".
TRACKED_ACTIVITY_TITLE="Pantheon"


# ---------- Optional: speedrun.com ----------

# Speedrun.com profile handle, e.g. "mySpeedrunHandle". When set, used to
# look up your PBs. The endpoint is public, so no key is strictly required.
# SPEEDRUN_USERNAME=

# Optional speedrun.com API key (https://www.speedrun.com/api/auth while
# logged in). When set:
#   - Requests carry an X-API-Key header for higher rate limits.
#   - If SPEEDRUN_USERNAME is NOT set, the username is auto-resolved from
#     your authenticated profile.
# SPEEDRUN_API_KEY=


# ---------- Optional: link pills ----------

# Set DISABLE_DEFAULT_LINKS=true to hide the auto-generated Raid Report /
# Last.fm link pills. The Join Code copy pill is identity, not an external
# link, so it stays regardless of this flag.
DISABLE_DEFAULT_LINKS=true

# Add up to 20 extra pills as EXTRA_LINK_1, EXTRA_LINK_2, etc.
# Format: "Label|value". For most pills, value is the full URL.
# Numbering gaps are fine.
# EXTRA_LINK_1=Steam|https://steamcommunity.com/id/yourname/
# EXTRA_LINK_2=Spotify|https://open.spotify.com/user/yourid
# EXTRA_LINK_4=GitHub|https://github.com/yourname
#
# Special-case: a pill with the label "Discord" (case-insensitive) does NOT
# open a URL — clicking copies the value to the clipboard. Use this for your
# Discord username so visitors can paste it into a friend search.
# EXTRA_LINK_3=Discord|yourname
#
# The default Bungie.net pill also copies (your "Name#Code" tag) instead of
# opening a profile, so it's one click to share.
